// Managed by t2-mac-kde (desktop) (template: bar_graphs = {{ bar_graphs }}). Source bar: clock + CPU/MEM/net, like the Omarchy setup.
// The internal T2 panel has a defective strip at its left edge (KDE used a 20 px panel):
// on eDP-1 a black left_reserve px wide bar reserves it for windows (exclusive zone)
// and the top bar starts after it. A Hyprland monitor rule cannot do this without
// replacing the panel mode.
{% set body %}
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 6,
  "modules-left": ["custom/menu", "custom/files", "custom/term", "custom/web", "custom/layout", "wlr/taskbar"],
  "modules-center": [],
  "modules-right": ["custom/quota", {% if bar_graphs %}"custom/cpu", "custom/mem", "custom/thermal", "custom/net"{% else %}"cpu", "memory", "custom/thermal", "custom/netrate"{% endif %}, "group/audio", "backlight", "custom/power-profile", "battery", "tray", "hyprland/submap", "custom/cliphist", "custom/nightmode", "custom/termtheme", "custom/kbd", "clock", "custom/power"],
  "custom/menu": {
    "format": "☰ Apps",
    "tooltip-format": "Applications (right-click: search)",
    "on-click": "$HOME/.local/bin/hypr-launch $HOME/.local/bin/hypr-appmenu",
    "on-click-right": "$HOME/.local/bin/hypr-launch fuzzel"
  },
  // Quick launchers: the apps' own icons are the CSS background (see style.css).
  // Apps start through hypr-launch (Hyprland), never as waybar's children:
  // waybar kills the processes it started whenever it reloads.
  "custom/files": { "format": " ", "tooltip-format": "File manager (Xfe)", "on-click": "$HOME/.local/bin/hypr-launch xfe" },
  "custom/term": { "format": " ", "tooltip-format": "Terminator", "on-click": "$HOME/.local/bin/hypr-launch hypr-term" },
  "custom/web": { "format": " ", "tooltip-format": "Vivaldi", "on-click": "$HOME/.local/bin/hypr-launch vivaldi-stable.desktop" },
  // Red square with the swirl: the PNG is the CSS background (see style.css).
  // (waybar 0.15's "image" module hangs the bar at startup.)
  "custom/power": {
    "format": " ",
    "tooltip-format": "Lock / suspend{% if hibernate %} / hibernate{% endif %} / log out / reboot / shut down",
    "on-click": "$HOME/.local/bin/hypr-launch $HOME/.local/bin/hypr-appmenu power"
  },
  // Clipboard history (in RAM, wiped nightly at 01:00): click = pick, right-click = wipe now
  "custom/cliphist": {
    "exec": "$HOME/.local/bin/hypr-cliphist status",
    "return-type": "json",
    "interval": 30,
    "signal": 13,
    "on-click": "$HOME/.local/bin/hypr-launch $HOME/.local/bin/hypr-cliphist pick",
    "on-click-right": "$HOME/.local/bin/hypr-cliphist wipe"
  },
  // Night filter: rabbit black = off, green = mint night filter, white = dark (click: next)
  "custom/nightmode": {
    "exec": "$HOME/.local/bin/hypr-nightmode status",
    "return-type": "json",
    "interval": "once",
    "signal": 12,
    "on-click": "$HOME/.local/bin/hypr-nightmode next",
    "on-click-right": "$HOME/.local/bin/hypr-nightmode off"
  },
  "custom/termtheme": {
    "exec": "$HOME/.local/bin/hypr-termtheme-status",
    "return-type": "json",
    "interval": "once",
    "signal": 10,
    "on-click": "$HOME/.local/bin/hypr-termtheme next",
    "on-click-right": "$HOME/.local/bin/hypr-termtheme prev"
  },
  // SUPER badge while one-shot Super (SHIFT + Print) is armed
  "hyprland/submap": { "format": "SUPER", "tooltip": false },
  "custom/kbd": {
    "exec": "printf '⌨ %s\\n' $( (cat $HOME/.local/state/hypr-kbd 2>/dev/null || echo de) | tr a-z A-Z)",
    "interval": "once",
    "signal": 9,
    "tooltip-format": "Keyboard layout (click: switch US / DE)",
    "on-click": "$HOME/.local/bin/hypr-kbd toggle"
  },
  "custom/layout": {
    "exec": "$HOME/.local/bin/hypr-layout waybar",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "$HOME/.local/bin/hypr-layout next"
  },
  // Window list: click = bring to front (also un-minimizes), middle-click = close.
  "wlr/taskbar": {
    "format": "{icon} {title:.18}",
    "icon-size": 16,
    "icon-theme": "Adwaita",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["fuzzel"]
  },
  // Laptop: screen brightness (scroll = +/-5%) and battery (macsmc-battery on T2).
  "backlight": {
    "device": "gmux_backlight", "format": "󰃠 {percent}%", "tooltip": false,
    "on-scroll-up": "$HOME/.local/bin/hypr-brightness screen +5",
    "on-scroll-down": "$HOME/.local/bin/hypr-brightness screen -5"
  },
  "battery": {
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}%", "format-charging": "󰂄 {capacity}%", "format-plugged": "{icon} {capacity}%", "format-full": "{icon} {capacity}%",
    "format-icons": ["󰂎", "󰁻", "󰁽", "󰁿", "󰂁", "󰁹"], "tooltip-format": "{timeTo} ({power} W)\nclick: power profile",
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power-profile-menu.xml",
    "menu-actions": {
      "power-saver": "$HOME/.local/bin/hypr-power-profile power-saver",
      "balanced": "$HOME/.local/bin/hypr-power-profile balanced",
      "performance": "$HOME/.local/bin/hypr-power-profile performance"
    }
  },
  // Power profile (power-profiles-daemon): icon shows the current one; click = drop-down.
  "custom/power-profile": {
    "exec": "$HOME/.local/bin/hypr-power-profile waybar",
    "return-type": "json", "interval": 30, "signal": 12,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power-profile-menu.xml",
    "menu-actions": {
      "power-saver": "$HOME/.local/bin/hypr-power-profile power-saver",
      "balanced": "$HOME/.local/bin/hypr-power-profile balanced",
      "performance": "$HOME/.local/bin/hypr-power-profile performance"
    }
  },
  "clock": { "format": "{:%a %H:%M}", "format-alt": "{:%d %B %Y  W%V}", "tooltip": false },
{% if bar_graphs %}
  // CPU / memory / network with a sparkline of the last 50 s (hypr-sparkline, every 5 s)
  "custom/cpu": { "exec": "$HOME/.local/bin/hypr-sparkline cpu", "return-type": "json",
                  "on-click": "$HOME/.local/bin/hypr-launch hypr-term -x btop" },
  "custom/mem": { "exec": "$HOME/.local/bin/hypr-sparkline mem", "return-type": "json" },
  "custom/net": { "exec": "$HOME/.local/bin/hypr-sparkline net", "return-type": "json" },
{% else %}
  // CPU / memory / network as numbers (bar_graphs = False)
  "cpu": { "interval": 5, "format": "󰍛 {usage}%", "on-click": "$HOME/.local/bin/hypr-launch hypr-term -x btop" },
  "memory": { "interval": 5, "format": "󰘚 {percentage}%", "tooltip-format": "{used:0.1f} / {total:0.1f} GiB used" },
  // Network: compact "↓69K ↑20K" (hypr-netrate); interface + IP in the tooltip.
  "custom/netrate": { "exec": "$HOME/.local/bin/hypr-netrate", "return-type": "json" },
{% endif %}
  // Temperatures + fans (the iStat Menus part): CPU package on the bar, the rest in the tooltip.
  "custom/thermal": { "exec": "$HOME/.local/bin/hypr-thermal", "return-type": "json", "interval": 5,
                      "on-click": "$HOME/.local/bin/hypr-launch hypr-term -x btop" },
  // AI agents: weekly quota left (Claude, Codex), every 5 min; click = refresh
  "custom/quota": {
    "exec": "$HOME/.local/bin/hypr-agent-quota",
    "return-type": "json",
    "interval": 300,
    "signal": 11,
    "on-click": "pkill -RTMIN+11 -u $(id -u) -x waybar"
  },
  // Speaker icon; hover reveals the volume slider. Click = mute, scroll = ±5%.
  "group/audio": {
    "orientation": "horizontal",
    "drawer": { "transition-duration": 250, "transition-left-to-right": false },
    "modules": ["pulseaudio", "pulseaudio/slider"]
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "tooltip-format": "Volume {volume}% (click: mute, scroll: adjust, hover: slider)",
    "scroll-step": 5,
    "max-volume": 100,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "pulseaudio/slider": { "min": 0, "max": 100, "orientation": "horizontal" },
  "tray": { "spacing": 8 }
{% endset %}
{% if left_reserve %}
[
{ "output": "eDP-1", "margin-left": {{ left_reserve }},
{{ body }}
},
{ "output": "!eDP-1",
{{ body }}
},
{ "output": "eDP-1", "name": "leftstrip", "layer": "top", "position": "left",
  "width": {{ left_reserve }}, "exclusive": true, "spacing": 0,
  "modules-left": ["custom/strip"], "modules-center": [], "modules-right": [],
  "custom/strip": { "format": " ", "tooltip": false }
}
]
{% else %}
{
{{ body }}
}
{% endif %}
