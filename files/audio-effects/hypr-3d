#!/bin/sh
# Managed by t2-mac-kde (audio_effects). Toggle the QC35 "3D" sound (EasyEffects global bypass).
#   hypr-3d on | off | toggle | status | room | plain | plus | auditorium | stage   (switch: switch the QC35 preset live)
# Speakers/T2 headphones always autoload the empty "Bypass" preset, so this only changes the QC35.
set -eu
unit=easyeffects.service
state="${XDG_RUNTIME_DIR:-/tmp}/hypr-3d.state"
running() { systemctl --user is-active -q "$unit"; }
current() {
    running || { echo off; return; }
    cat "$state" 2>/dev/null || echo on
}
case "${1:-status}" in
on)
    if ! running; then
        systemctl --user is-active -q hypr-desktop.target || { echo "hypr-3d: no Hyprland session" >&2; exit 1; }
        systemctl --user start "$unit"; sleep 1
    fi
    easyeffects -b 2 >/dev/null && echo on > "$state" ;;
off)
    # without a running EasyEffects the audio path is already untouched
    if running; then easyeffects -b 1 >/dev/null; fi
    echo off > "$state" ;;
room|plain|plus|auditorium|stage)
    running || { echo "hypr-3d: EasyEffects not running" >&2; exit 1; }
    case "$1" in room) p="QC35 3D Room" ;; plus) p="QC35 3D Room+" ;; auditorium) p="QC35 3D Auditorium" ;; stage) p="QC35 3D Stage" ;; *) p="QC35 3D" ;; esac
    easyeffects -l "$p" >/dev/null && easyeffects -b 2 >/dev/null && echo on > "$state" && echo "3D: $p" ;;
toggle)
    if [ "$(current)" = on ]; then exec "$0" off; else exec "$0" on; fi ;;
status)
    if running; then echo "3D: $(current) (EasyEffects running, preset: $(easyeffects -a output 2>/dev/null || echo '?'))"
    else echo "3D: off (EasyEffects not running)"; fi ;;
*)
    echo "usage: hypr-3d on|off|toggle|status|room|plain|plus|auditorium|stage" >&2; exit 2 ;;
esac
