# Managed by t2-mac-kde (desktop)
[Unit]
Description=Secret Service (KDE wallet, unlocked at login) for the Hyprland session
PartOf=hypr-desktop.target
After=graphical-session.target

[Service]
# At login pam_kwallet5 starts "ksecretd --pam-login" holding the unlocked wallet and waits on
# $PAM_KWALLET5_LOGIN for the session environment. Plasma sends it via pam_kwallet_init; Hyprland
# doesn't, so we do: that ksecretd then owns org.freedesktop.secrets with no password prompt.
# Fallback (no PAM handoff, e.g. password-less login): D-Bus-activate ksecretd, which may ask once.
Type=oneshot
RemainAfterExit=yes
ExecStart=-/bin/sh -c '[ -n "$PAM_KWALLET5_LOGIN" ] && /usr/share/libpam-kwallet-common/pam_kwallet_init; sleep 1'
ExecStart=/usr/bin/busctl --user call org.kde.secretservicecompat / org.freedesktop.DBus.Peer Ping
# kwalletd6 guard: browsers on --password-store=kwallet6 read through kwalletd6, which can come up
# answering every read with "" and makes them offer to drop saved logins. Restart it when it does.
ExecStart=-%h/.local/bin/hypr-wallet-check

[Install]
WantedBy=hypr-desktop.target
