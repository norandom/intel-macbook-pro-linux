# Managed by t2-mac-kde (desktop)
[Unit]
Description=Secret Service (KDE wallet via ksecretd) for the Hyprland session
PartOf=hypr-desktop.target
After=graphical-session.target

[Service]
# Plasma registers org.freedesktop.secrets itself; in Hyprland nothing does, so gh, git
# credential helpers and apps found no keyring. D-Bus-activate KDE's compatibility service
# (ksecretd), which then owns org.freedesktop.secrets; the wallet is unlocked by pam_kwallet.
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/busctl --user call org.kde.secretservicecompat / org.freedesktop.DBus.Peer Ping

[Install]
WantedBy=hypr-desktop.target
