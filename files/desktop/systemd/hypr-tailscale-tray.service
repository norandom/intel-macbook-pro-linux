# Managed by t2-mac-kde (desktop)
[Unit]
Description=Tailscale tray (connect, exit node on/off) in the Waybar and the KDE tray
PartOf=graphical-session.target
# Not After=graphical-session.target: ordering cycle with KDE's plasma-workspace.target.
After=waybar.service plasma-plasmashell.service
ConditionPathExists=/usr/bin/tailscale

[Service]
# Changing the exit node without sudo needs `tailscale set --operator=$USER`
# (tasks/remote_access.py does that once).
ExecStart=/usr/bin/tailscale systray
Restart=on-failure
RestartSec=5

[Install]
# hypr-desktop.target: Hyprland's session services; plasma-workspace.target: KDE's.
WantedBy=hypr-desktop.target plasma-workspace.target
