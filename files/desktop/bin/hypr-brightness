#!/usr/bin/env bash
# Managed by t2-mac-kde (desktop). Brightness via logind (no root, no udev rule):
#   hypr-brightness screen|kbd +5|-5|N%   (percent steps; backlight never fully dark)
# Screen: one more step down at the minimum turns the backlight off (dark panel);
# the next step up turns it back on at the minimum. Other input does not wake it.
set -eu
case "${1:-}" in
  screen) dev=$(basename "$(ls -d /sys/class/backlight/gmux_backlight /sys/class/backlight/* 2>/dev/null | grep -v appletb | head -1)"); sub=backlight; base=/sys/class/backlight/$dev; min=2 ;;
  kbd) dev=$(basename "$(ls -d /sys/class/leds/*kbd_backlight* 2>/dev/null | head -1)"); sub=leds; base=/sys/class/leds/$dev; min=0 ;;
  *) echo "usage: hypr-brightness screen|kbd +N|-N|N%" >&2; exit 2 ;;
esac
[ -n "$dev" ] && [ -r "$base/max_brightness" ] || { echo "hypr-brightness: no $1 device" >&2; exit 1; }
max=$(cat "$base/max_brightness"); cur=$(cat "$base/brightness"); step=${2:-+5}
pct=$(( (cur * 100 + max / 2) / max ))
# Screen "off" = backlight 0 (dark panel, backlight power off). No DPMS: waking a panel via
# DPMS makes gmux restore 100 % for a moment; a backlight change has no such flash.
if [ "$1" = screen ] && [ "${HYPR_OSD:-1}" != 0 ]; then
  set_raw() { busctl call org.freedesktop.login1 /org/freedesktop/login1/session/auto \
                org.freedesktop.login1.Session SetBrightness ssu "$sub" "$dev" "$1"; }
  if [ "$cur" -eq 0 ]; then   # dark: only a step up lights it again, at the minimum
    case "$step" in
      +*) set_raw $(( max * min / 100 )); ~/.local/bin/hypr-osd screen "$min" "Brightness" ;;
    esac
    exit 0
  fi
  case "$step" in
    -*) if [ "$pct" -le "$min" ]; then set_raw 0; exit 0; fi ;;
  esac
fi
case "$step" in
  +*) pct=$(( pct + ${step#+} )) ;;
  -*) pct=$(( pct - ${step#-} )) ;;
  *%) pct=${step%\%} ;;
esac
[ "$pct" -gt 100 ] && pct=100; [ "$pct" -lt "$min" ] && pct=$min
busctl call org.freedesktop.login1 /org/freedesktop/login1/session/auto \
  org.freedesktop.login1.Session SetBrightness ssu "$sub" "$dev" $(( max * pct / 100 ))
[ "${HYPR_OSD:-1}" = 0 ] || ~/.local/bin/hypr-osd "$1" "$pct" "$([ "$1" = kbd ] && echo Keyboard light || echo Brightness)"
