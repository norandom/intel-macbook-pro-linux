#!/bin/sh
# Managed by t2-mac-kde (desktop). Toggle "stay on top" for the active window (title bar
# button). Hyprland's pin keeps a floating window above the others; tiled windows are
# floated first. One address is read once, so a focus change cannot redirect the toggle.
addr=$(hyprctl activewindow -j | jq -r '.address // empty')
case "$addr" in 0x[0-9a-fA-F]*) ;; *) exit 1 ;; esac
if [ "$(hyprctl clients -j | jq -r --arg a "$addr" '.[] | select(.address == $a) | .floating')" = "false" ]; then
  hyprctl dispatch setfloating "address:$addr" >/dev/null
fi
hyprctl dispatch pin "address:$addr" >/dev/null
pinned=$(hyprctl clients -j | jq -r --arg a "$addr" '.[] | select(.address == $a) | .pinned')
[ "$pinned" = "true" ] && msg="Stay on top: on" || msg="Stay on top: off"
hyprctl notify -1 1500 "rgb(8bb4e0)" "$msg" >/dev/null
