#!/bin/sh
# Managed by t2-mac-kde (desktop). Night filter for the whole screen (screen shader):
#   hypr-nightmode next|off|green|dark|apply|status
#   off   = normal (rabbit black), green = mint night filter (rabbit green),
#   dark  = simply darker (rabbit white). The bar rabbit cycles off -> green -> dark.
# The choice is kept in ~/.local/state/hypr-nightmode; looknfeel.conf runs "apply" after
# every config load (a reload resets the shader).
state="$HOME/.local/state/hypr-nightmode"
shaders="$HOME/.config/hypr/shaders"
cur=$(cat "$state" 2>/dev/null || echo off)
case "$cur" in off|green|dark) ;; *) cur=off ;; esac

case "${1:-status}" in
  status)
    case "$cur" in
      green) tip="Night filter: green (click: dark)" ;;
      dark)  tip="Night filter: dark (click: off)" ;;
      *)     tip="Follow the white rabbit… (click: green night filter, again: dark)" ;;
    esac
    printf '{"text":"\363\260\244\207","class":"%s","tooltip":"%s"}\n' "$cur" "$tip"
    exit 0 ;;
  next) case "$cur" in off) new=green ;; green) new=dark ;; *) new=off ;; esac ;;
  off|green|dark) new=$1 ;;
  apply) new=$cur ;;
  *) echo "usage: hypr-nightmode next|off|green|dark|apply|status" >&2; exit 2 ;;
esac

case "$new" in
  off) path="[[EMPTY]]" ;;
  *) path="$shaders/night-$new.glsl" ;;
esac
if [ "${1:-}" = apply ] && [ "$new" = off ]; then
  exit 0   # a reload already reset the shader
fi
hyprctl keyword decoration:screen_shader "$path" >/dev/null || exit 1
[ "$1" = apply ] || { mkdir -p "${state%/*}" && echo "$new" > "$state"; }
pkill -RTMIN+12 -u "$(id -u)" -x waybar 2>/dev/null
exit 0
