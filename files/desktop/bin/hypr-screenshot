#!/usr/bin/env bash
# Managed by t2-mac-kde (desktop). Greenshot-style screenshots on Hyprland.
#   hypr-screenshot edit     area -> Satty editor (arrows, boxes, text, blur, crop; save/copy there)
#   hypr-screenshot screen   focused screen -> Satty editor
#   hypr-screenshot quick    area -> ~/Pictures/Screenshots + clipboard, no editor
set -eu
dir=${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots; mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
satty=$HOME/.local/bin/satty
edit() {  # read PNG on stdin
  if [ -x "$satty" ]; then
    "$satty" --filename - --output-filename "$file" --copy-command wl-copy \
      --early-exit --initial-tool arrow
  else
    cat > "$file"; wl-copy < "$file"
    notify-send -a Screenshot "Satty not installed: saved without editor" "$file" 2>/dev/null || true
  fi
}
case "${1:-edit}" in
  edit|area) geom=$(slurp) || exit 0; grim -g "$geom" - | edit ;;
  screen) grim -o "$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .name')" - | edit ;;
  quick) geom=$(slurp) || exit 0; grim -g "$geom" "$file"; wl-copy < "$file"
         notify-send -a Screenshot "Screenshot saved" "$file" 2>/dev/null || true ;;
  *) echo "usage: hypr-screenshot edit|screen|quick" >&2; exit 2 ;;
esac
