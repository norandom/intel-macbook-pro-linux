#!/usr/bin/env bash
# Managed by t2-mac-kde (desktop). "Where is my pointer?": blow the cursor up for a moment
# (like Windows' "show pointer location"), then restore the configured theme and size.
set -u
conf=$HOME/.config/hypr/cursor.conf
theme=$(sed -n 's/^env = XCURSOR_THEME,//p' "$conf" 2>/dev/null); theme=${theme:-breeze_cursors}
size=$(sed -n 's/^env = XCURSOR_SIZE,//p' "$conf" 2>/dev/null); size=${size:-24}
for s in 128 96 128 96 128; do hyprctl setcursor "$theme" "$s" >/dev/null; sleep 0.18; done
hyprctl setcursor "$theme" "$size" >/dev/null
