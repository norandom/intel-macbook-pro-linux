#!/bin/sh
# Managed by t2-mac-kde (desktop). Render ~/.config/hypr/state.conf from the switch files
# (Hyprland 0.53 has no Lua: this replaces the source's runtime file reads):
#   ~/.config/hypr/layout-mode          dynamic|golden-h|golden-v|golden-spiral  (hypr-layout)
#   ~/.config/hypr/decorations-style    mac|win311                               (hypr-deco)
#   ~/.config/hypr/window-shadows       on|off                                   (hypr-shadow)
# The hyprbars plugin path comes from the package's own file list (dpkg), never guessed,
# unless the patched build in ~/.local/lib/t2-mac-kde/hyprbars matches the installed Hyprland.
#   hypr-desktop-state [--reload]       --reload: hyprctl reload when the file changed
set -eu
dir="$HOME/.config/hypr"
first() { v=$(sed -n '1{s/^[[:space:]]*//;s/[[:space:]].*//;p;q}' "$1" 2>/dev/null || true); echo "${v:-$2}"; }
layout=$(first "$dir/layout-mode" dynamic)
style=$(first "$dir/decorations-style" mac)
shadow=$(first "$dir/window-shadows" off)
case "$layout" in dynamic|golden-h|golden-v|golden-spiral) ;; *) layout=dynamic ;; esac
case "$style" in mac|win311) ;; *) style=mac ;; esac
case "$shadow" in on) shadow=$style ;; *) shadow=off ;; esac
plugin=$(dpkg-query -L hyprland-plugin-hyprbars 2>/dev/null | grep '/libhyprbars\.so$' | head -n 1 || true)
# Our patched build (build-hyprbars) wins while it was built for the installed Hyprland;
# after a Hyprland update it would be refused, so the package plugin is used until rebuilt.
own="$HOME/.local/lib/t2-mac-kde/hyprbars"
hv=$(dpkg-query -W -f='${Version}' hyprland 2>/dev/null || true)
if [ -n "$hv" ] && [ -f "$own/libhyprbars.so" ] && grep -qx "hyprland=$hv patch=.*" "$own/stamp" 2>/dev/null; then
  plugin="$own/libhyprbars.so"
fi

tmp=$(mktemp "$dir/.state.conf.XXXXXX")
trap 'rm -f "$tmp"' EXIT
{
  echo "# Generated by hypr-desktop-state: do not edit (layout=$layout style=$style shadows=$shadow)"
  echo "source = $dir/layout-$layout.conf"
  echo "source = $dir/borders.conf"
  if [ -n "$plugin" ] && [ -f "$plugin" ]; then
    echo "plugin = $plugin"
    echo "source = $dir/decorations-$style.conf"
  else
    echo "# hyprbars not installed (package hyprland-plugin-hyprbars): no title bars"
  fi
  echo "source = $dir/shadow-$shadow.conf"
  [ -f "$dir/local.conf" ] && echo "source = $dir/local.conf"
  true
} > "$tmp"
if cmp -s "$tmp" "$dir/state.conf"; then
  exit 0
fi
chmod 644 "$tmp"
mv -f "$tmp" "$dir/state.conf"
trap - EXIT
if [ "${1:-}" = --reload ] && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  hyprctl reload >/dev/null
fi
