#!/usr/bin/env bash
# Managed by t2-mac-kde (desktop). Which GPUs Hyprland and KDE's KWin use (next login of either):
#   hypr-gpu battery    Intel only: nothing renders on the AMD GPU, external displays off
#   hypr-gpu external   Intel renders, AMD drives the external display ports
#   hypr-gpu status     configured vs running mode, AMD load and power draw
#   hypr-gpu battery|external --now   switch and log out right away
# KDE reads the same mode (~/.config/plasma-workspace/env/t2-gpu.sh, KWIN_DRM_DEVICES): with both
# GPUs KWin stalls on the AMD side of the muxed internal panel. This Mac has no runtime power-off
# for the AMD GPU ("Runtime PM not
# available"), so battery mode keeps it idle at its lowest power level rather than off.
set -u
export LC_NUMERIC=C
state=${XDG_STATE_HOME:-$HOME/.local/state}/t2-mac-kde/gpu-mode
configured=$(cat "$state" 2>/dev/null || echo battery)
amd_dev=""
for c in /sys/class/drm/card[0-9]; do   # by driver, so it works before the udev names exist
  [ "$(basename "$(readlink -f "$c/device/driver" 2>/dev/null)")" = amdgpu ] && amd_dev=$c/device && break
done

running() {   # running <pgrep -f pattern> <variable>
  local pid env; pid=$(pgrep -f -u "$(id -u)" "$1" | head -1)
  [ -n "$pid" ] || { echo "not running"; return; }
  env=$(tr '\0' '\n' 2>/dev/null < "/proc/$pid/environ") || { echo "unknown"; return; }
  case "$(printf '%s\n' "$env" | sed -n "s/^$2=//p")" in
    *amd-dgpu*) echo external ;; *intel-igpu*) echo battery ;; *) echo "default (all GPUs)" ;;
  esac
}

status() {
  echo "configured: $configured (next login)"
  [ -e /dev/dri/intel-igpu ] || echo "note:       /dev/dri/intel-igpu missing: run the desktop deploy (udev rule)"
  echo "Hyprland:   $(running '(^|/)Hyprland( |$)' AQ_DRM_DEVICES)"
  echo "KDE KWin:   $(running '^/usr/bin/kwin_wayland_wrapper' KWIN_DRM_DEVICES)"   # KWin itself has caps: no /proc read
  if [ -n "$amd_dev" ]; then
    local w; w=$(cat "$amd_dev"/hwmon/hwmon*/power1_average 2>/dev/null | head -1)
    echo "AMD GPU:    $(cat "$amd_dev/gpu_busy_percent" 2>/dev/null || echo ?)% busy, $(awk -v u="${w:-0}" 'BEGIN{printf "%.1f", u/1000000}') W"
  else
    echo "AMD GPU:    not found"
  fi
  local ext; ext=$(for c in /sys/class/drm/card*-DP-* /sys/class/drm/card*-HDMI-*; do
    [ "$(cat "$c/status" 2>/dev/null)" = connected ] && basename "$c"; done | paste -sd, -)
  echo "external:   ${ext:-none connected}"
}

case "${1:-status}" in
  status) status ;;
  battery|external)
    mkdir -p "$(dirname "$state")"; echo "$1" > "$state"
    if [ "${2:-}" = --now ]; then
      notify-send -a GPU "GPU mode: $1" "Logging out to apply" 2>/dev/null; sleep 1
      if pgrep -x -u "$(id -u)" Hyprland >/dev/null; then exec uwsm stop; fi
      exec qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout
    fi
    msg="GPU mode $1 from the next login, Hyprland or KDE (or: hypr-gpu $1 --now)"
    echo "$msg"; notify-send -a GPU "GPU mode: $1" "Applies at the next login" 2>/dev/null || true ;;
  *) echo "usage: hypr-gpu battery|external [--now] | status" >&2; exit 2 ;;
esac
