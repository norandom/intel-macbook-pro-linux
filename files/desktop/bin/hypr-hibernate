#!/usr/bin/env bash
# Managed by t2-mac-kde (desktop). Hibernate (suspend to disk) only when the image fits:
# used RAM (minus reclaimable cache) must fit into free disk swap (zram cannot hold it).
set -u
used_kb=$(awk '/^MemTotal/{t=$2} /^MemAvailable/{a=$2} END{print t-a}' /proc/meminfo)
disk_free_kb=$(awk 'NR>1 && $1 !~ /zram/ {f += $3 - $4} END{print f+0}' /proc/swaps)
if [ "$used_kb" -ge "$disk_free_kb" ]; then
  msg="Needs $((used_kb/1048576)) GiB, disk swap has $((disk_free_kb/1048576)) GiB free. Close apps or use Suspend."
  notify-send -a Power -u critical "Hibernate not possible" "$msg" 2>/dev/null || echo "$msg" >&2
  exit 1
fi
exec systemctl hibernate
