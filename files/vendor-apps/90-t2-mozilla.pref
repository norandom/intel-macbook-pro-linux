# Managed by t2-mac-kde: Mozilla's repo may only supply Firefox Developer Edition,
# and Ubuntu's snap-transitional firefox is never a candidate.
Package: *
Pin: origin packages.mozilla.org
Pin-Priority: -1

Package: firefox-devedition firefox-devedition-l10n-*
Pin: origin packages.mozilla.org
Pin-Priority: 1000

Package: firefox
Pin: release o=Ubuntu
Pin-Priority: -1
